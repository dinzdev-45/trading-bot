# ======================================================================
#  pump.fun momentum bot — salin file ini ke .env lalu ubah sesuai kebutuhan
#  JANGAN commit file .env (sudah ada di .gitignore)
# ======================================================================

# --- Mode -------------------------------------------------------------
# paper = simulasi (default, tidak ada uang sungguhan)
# live  = transaksi sungguhan; wajib isi LIVE_TRADING_CONFIRM dan WALLET_PRIVATE_KEY
MODE=paper
LIVE_TRADING_CONFIRM=
LOG_LEVEL=info              # debug untuk melihat alasan token ditolak
DATA_DIR=data               # jurnal trade (JSONL) disimpan di sini
RECORD_FILE=                # contoh: data/rec-2026-11-22.jsonl (rekam feed untuk replay)

# --- Feed -------------------------------------------------------------
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=
MAX_TRACKED_TOKENS=400
METADATA_TIMEOUT_MS=4000

# --- Filter masuk -------------------------------------------------------
MIN_CURVE_PROGRESS=0.30
MAX_CURVE_PROGRESS=0.70
MOMENTUM_WINDOW_SEC=300     # jendela hitung momentum (5 menit)
MIN_UNIQUE_BUYERS=15
MIN_BUY_SELL_RATIO=2        # volume beli / volume jual
MIN_BUY_VOLUME_SOL=5
MIN_TOKEN_AGE_SEC=30
MAX_TOKEN_AGE_SEC=1800

# --- Cek keamanan -------------------------------------------------------
MAX_DEV_HOLD_PCT=10
BLOCK_IF_DEV_SOLD=true
MAX_TOP10_HOLD_PCT=30
BUNDLE_WINDOW_SEC=3         # wallet yang beli di N detik pertama dianggap "early/bundle"
MAX_EARLY_BUYERS_HOLD_PCT=15
REQUIRE_SOCIALS=true        # minimal ada twitter / telegram / website di metadata

# --- Ukuran & eksekusi --------------------------------------------------
BUY_AMOUNT_SOL=0.1
SLIPPAGE_PCT=15
PAPER_EXTRA_SLIPPAGE_PCT=3  # simulasi keterlambatan di mode paper
PRIORITY_FEE_SOL=0.0005
USE_JITO=true
JITO_TIP_SOL=0.001
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
RPC_URL=https://api.mainnet-beta.solana.com
# Private key wallet KHUSUS bot (base58 dari Phantom, atau array JSON). Jangan pakai wallet utama.
WALLET_PRIVATE_KEY=

# --- Keluar -------------------------------------------------------------
TAKE_PROFIT_LEVELS=2:0.5    # format kelipatan:porsi, mis. 2:0.5,4:0.25
TRAILING_STOP_PCT=25
TRAILING_ACTIVATE_MULTIPLE=1.5
STOP_LOSS_PCT=30
MOMENTUM_DEATH_SEC=180      # keluar kalau tidak ada pembeli selama 3 menit
MAX_HOLD_SEC=1800
GRADUATION_SELL_PROGRESS=0.95
GRADUATION_SELL_FRACTION=1  # porsi yang dijual menjelang lulus (0 = matikan)

# --- Risiko -------------------------------------------------------------
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_SOL=1
STARTING_BALANCE_SOL=5      # saldo simulasi mode paper
SUMMARY_INTERVAL_SEC=60

# --- Strategi -----------------------------------------------------------
MOMENTUM_ENABLED=true       # false = hanya copy trading whale

# --- Copy trading (ikut wallet whale) -----------------------------------
# Kosong = copy trading mati. Pisahkan dengan koma, boleh pakai label: nama:ALAMAT
# contoh: COPY_WALLETS=whale1:7xKX...abc,whale2:9aBc...xyz
COPY_WALLETS=
COPY_WALLETS_FILE=          # atau file berisi satu alamat per baris (boleh "ALAMAT label", # untuk komentar)
COPY_BUY_AMOUNT_SOL=0.05    # ukuran beli per copy (terpisah dari BUY_AMOUNT_SOL)
COPY_MAX_OPEN_POSITIONS=2   # maks posisi copy bersamaan (tetap dibatasi MAX_OPEN_POSITIONS total)
COPY_MIN_WHALE_BUY_SOL=0.5  # abaikan pembelian whale yang lebih kecil dari ini
COPY_MAX_CURVE_PROGRESS=0.8 # jangan ikut kalau curve sudah lewat 80%
COPY_MAX_PRICE_MOVE_PCT=25  # jangan ikut kalau harga sudah naik >25% sejak whale beli (telat)
COPY_SIGNAL_TTL_SEC=15      # berapa lama sinyal boleh menunggu metadata
COPY_MAX_TOP10_HOLD_PCT=50  # top 10 holder (tanpa whale yang diikuti)
COPY_REQUIRE_SOCIALS=false  # true = token yang di-copy juga wajib punya sosmed
COPY_SKIP_IF_WHALE_IS_DEV=true
COPY_ADOPT_UNSEEN_TOKENS=true  # ikut juga token yang dibuat sebelum bot jalan (data holder tidak lengkap)
COPY_EXIT_ON_WHALE_SELL=true   # jual saat whale jual
COPY_WHALE_SELL_EXIT_PCT=50    # whale jual >=50% bagiannya -> kita jual semua; kurang dari itu -> jual porsi yang sama
PUMPFUN_API_URL=https://frontend-api-v3.pump.fun  # info token yang tidak terlihat saat launch

# --- Dashboard web ------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1    # hanya bisa dibuka dari komputer ini; jangan ganti ke 0.0.0.0
DASHBOARD_PORT=3000         # kalau terpakai, bot otomatis mencoba 3001, 3002, ...

# --- Konstanta curve pump.fun (ubah hanya kalau pump.fun mengubah aturannya)
CURVE_INITIAL_VIRTUAL_TOKENS=1073000000
CURVE_REAL_TOKENS_FOR_SALE=793100000
PUMP_FEE_BPS=125
